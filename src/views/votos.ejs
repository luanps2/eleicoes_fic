<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=titulo%>
    </title>
</head>

<body>
    <header>
        <h1>
            <%=titulo%>
        </h1>
    </header>
    <main>
        <section>
            <h2>Votos</h2>

            <% if (votos && votos.length> 0) { %>
                <ul>
                    <% votos.forEach(voto=> { %>
                        <li>
                            Candidato ID: <%= voto.candidatoId %> - Votos: <%= voto.votos %>
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>Nenhum voto encontrado.</p>
                <% } %>
        </section>
    </main>

</body>

</html>